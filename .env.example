# Supabase connection for the Campus client.
# These are PUBLIC by Expo's convention (EXPO_PUBLIC_*) and end up in the
# client bundle. Only the anon key belongs here.
#
# NEVER put the service-role key (or any other privileged secret) in a
# EXPO_PUBLIC_* variable, in this file, or anywhere reachable by the client.
# Service-role operations happen exclusively server-side (Supabase Edge
# Functions), configured via their own, separate, non-public secrets.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
